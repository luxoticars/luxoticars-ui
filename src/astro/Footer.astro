---
import type { FooterContact, FooterLink, FooterSocial } from "../types";
import * as defaults from "../data/footer";

interface Props {
  /**
   * Prefix for the generated heading ids the column `<nav>` landmarks point at.
   * Only needs changing if a page renders two footers.
   */
  idPrefix?: string;
  /** Wordmark text for the built-in logo fallback. Ignored when the `logo` slot is filled. */
  siteTitle?: string;
  /** Where the built-in wordmark links. Ignored when the `logo` slot is filled. */
  homeHref?: string;
  tagline?: string;
  brandsHeading?: string;
  brandLinks?: FooterLink[];
  companyHeading?: string;
  companyLinks?: FooterLink[];
  enquiriesHeading?: string;
  enquiriesText?: string;
  contacts?: FooterContact[];
  socials?: FooterSocial[];
  legalLinks?: FooterLink[];
  /** Overrides the whole copyright line. Defaults to "© <year> <siteTitle>. All rights reserved." */
  copyright?: string;
  year?: number;
  class?: string;
}

const {
  idPrefix = "footer",
  siteTitle = "Luxoticars",
  homeHref = "/",
  tagline = defaults.tagline,
  brandsHeading = "Shop by Brand",
  brandLinks = defaults.brandLinks,
  companyHeading = "Luxoticars",
  companyLinks = defaults.companyLinks,
  enquiriesHeading = "Enquiries",
  enquiriesText = defaults.enquiriesText,
  contacts = defaults.contacts,
  socials = defaults.socials,
  legalLinks = defaults.legalLinks,
  copyright,
  year = new Date().getFullYear(),
  class: className = "",
} = Astro.props as Props;

const brandsHeadingId = `${idPrefix}-heading-brands`;
const companyHeadingId = `${idPrefix}-heading-company`;
const copyrightLine = copyright ?? `© ${year} ${siteTitle}. All rights reserved.`;

// Kept out of the markup so a caller-supplied contact list can reference an icon
// by name rather than pasting path data. The email mark is stroked, the WhatsApp
// glyph is filled, hence the per-icon stroke flag.
const contactIcons = {
  email: {
    fill: "none",
    stroke: true,
    paths: ["M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "m2 7 10 6 10-6"],
  },
  whatsapp: {
    fill: "currentColor",
    stroke: false,
    paths: [
      "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z",
    ],
  },
} as const;
---

<footer class:list={["footer", className]}>
  <!-- Top seam: hairline transition from the section above -->
  <div aria-hidden="true" class="footer__seam"></div>

  <div class="footer__container">

    <!-- Masthead -->
    <div class="footer__masthead">
      <div class="footer__brand">
        <div class="footer__logo-wrap">
          {/* Home link, not a heading — an h1 down here gives every page on the
              site a second level-1 heading after its real one. */}
          <slot name="logo">
            <a href={homeHref} class="footer__wordmark-link">
              <span class="footer__wordmark">
                {siteTitle}
                <sub>&copy;</sub>
              </span>
            </a>
          </slot>
        </div>
        {tagline && <p class="footer__tagline">{tagline}</p>}
      </div>

      {socials.length > 0 && (
        <nav class="footer__socials" aria-label={`${siteTitle} on social media`}>
          {socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer__social-link"
              aria-label={`${siteTitle} on ${social.label} (opens in a new tab)`}
            >
              <svg class="footer__social-icon" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </nav>
      )}
    </div>

    <!-- Divider -->
    <div aria-hidden="true" class="footer__divider"></div>

    <!-- Link columns -->
    <div class="footer__columns">
      <!-- Brands -->
      {brandLinks.length > 0 && (
        <div class="footer__column footer__column--brands">
          <span aria-hidden="true" class="footer__column-accent"></span>
          <h2 id={brandsHeadingId} class="footer__column-heading footer__column-heading--brands">
            {brandsHeading}
          </h2>
          <nav aria-labelledby={brandsHeadingId}>
            <ul class="footer__link-list footer__link-list--brands">
              {brandLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer__link"
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                    {link.external && <span class="footer__sr-only"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}

      <!-- Company -->
      {companyLinks.length > 0 && (
        <div class="footer__column footer__column--company">
          <span aria-hidden="true" class="footer__column-accent"></span>
          <h2 id={companyHeadingId} class="footer__column-heading">
            {companyHeading}
          </h2>
          <nav aria-labelledby={companyHeadingId}>
            <ul class="footer__link-list">
              {companyLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer__link"
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                    {link.external && <span class="footer__sr-only"> (opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}

      <!-- Enquiries -->
      {contacts.length > 0 && (
        <div class="footer__column footer__column--enquiries">
          <span aria-hidden="true" class="footer__column-accent"></span>
          <h2 class="footer__column-heading">
            {enquiriesHeading}
          </h2>
          {enquiriesText && <p class="footer__enquiries-text">{enquiriesText}</p>}
          <div class="footer__contact-list">
            {contacts.map((contact) => {
              const icon = contactIcons[contact.icon];
              return (
                <a
                  href={contact.href}
                  class="footer__contact-link"
                  target={contact.external ? "_blank" : undefined}
                  rel={contact.external ? "noopener noreferrer" : undefined}
                >
                  <svg
                    class="footer__contact-icon"
                    viewBox="0 0 24 24"
                    fill={icon.fill}
                    stroke={icon.stroke ? "currentColor" : undefined}
                    stroke-width={icon.stroke ? 1.75 : undefined}
                    stroke-linecap={icon.stroke ? "round" : undefined}
                    stroke-linejoin={icon.stroke ? "round" : undefined}
                    aria-hidden="true"
                  >
                    {icon.paths.map((d) => <path d={d} />)}
                  </svg>
                  <span class="footer__link">{contact.label}</span>
                  {contact.external && <span class="footer__sr-only"> (opens in a new tab)</span>}
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <!-- Bottom bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">{copyrightLine}</p>
      {legalLinks.length > 0 && (
        <nav aria-label="Legal">
          <ul class="footer__legal-list">
            {legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer__link footer__link--small"
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                  {link.external && <span class="footer__sr-only"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

  </div>
</footer>

<style>
  /* Every design token is referenced with a literal fallback, so the component
     renders correctly in an app that defines none of them. An app that does
     define them (tokens.css, or Tailwind's @theme) overrides the fallback. */
  .footer {
    --_accent: var(--color-marque-accent, oklch(0.74 0.16 232.661));
    --_bg: var(--footer-bg, oklch(0.145 0 0));
    --_fg: var(--footer-fg, oklch(0.87 0 0));
    --_muted: var(--footer-muted, oklch(0.708 0 0));
    --_hairline: var(--footer-hairline, oklch(0.269 0 0));

    position: relative;
    overflow: hidden;
    background-color: var(--_bg);
    color: var(--_fg);
  }

  /* Self-contained reset.
     The two consuming apps disagree about what the browser defaults are:
     luxoticars-vi loads Tailwind, whose preflight already zeroes list markers,
     link underlines and heading/paragraph margins, while luxoticars-homepage
     ships no reset at all. Without resetting them here the same markup renders
     with bullet points, underlined blue links and stray UA margins on the
     homepage and correctly on vi.

     These land on the element's own class rather than on a descendant selector
     (`.footer :where(ul)`) on purpose. Astro appends its scope attribute to
     every compound selector, so a descendant reset compiles to a three-part
     selector that outranks the single-class rules below and silently wins the
     margins back. Per-class it is. */
  .footer__link,
  .footer__contact-link,
  .footer__social-link,
  .footer__wordmark-link {
    text-decoration: none;
  }

  /* Visually hidden, but announced. Defined here rather than assumed from the
     host app: luxoticars-homepage ships no Tailwind, so a bare `sr-only`
     class there is an undefined class and the text renders visibly. */
  .footer__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Top seam: hairline transition from the section above */
  .footer__seam {
    pointer-events: none;
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in oklab, var(--_hairline) 70%, transparent) 50%,
      transparent 100%
    );
  }

  .footer__container {
    position: relative;
    z-index: 10;
    margin-inline: auto;
    max-width: 80rem;
    padding-inline: 1.5rem;
  }

  /* ── Masthead ────────────────────────────────────────────────────────── */
  .footer__masthead {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer__brand {
    max-width: 28rem;
  }

  .footer__logo-wrap {
    width: fit-content;
  }

  /* Fallback wordmark, used only when the `logo` slot is empty. */
  .footer__wordmark-link {
    display: inline-flex;
    border-radius: 2px;
  }

  .footer__wordmark {
    position: relative;
    display: inline-flex;
    padding-right: 0.5rem;
    font-family: var(--font-futura-bold, var(--font-futura, inherit));
    font-size: var(--text-xl, 1.25rem);
    font-weight: var(--font-weight-bold, 700);
    color: var(--color-white, #fff);
    text-transform: uppercase;
  }

  .footer__wordmark sub {
    position: absolute;
    right: -0.2rem;
    bottom: 0.4rem;
    font-size: 0.45rem;
    font-weight: normal;
    line-height: 1;
  }

  .footer__tagline {
    margin: 1.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--_muted);
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    color: var(--_muted);
    box-shadow: 0 0 0 1px var(--_hairline);
    transition:
      transform 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  .footer__social-link:hover,
  .footer__social-link:focus-visible {
    transform: translateY(-0.125rem);
    color: #fff;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--_hairline) 60%, #fff);
  }

  .footer__social-icon {
    width: 1rem;
    height: 1rem;
  }

  /* ── Divider ─────────────────────────────────────────────────────────── */
  .footer__divider {
    height: 1px;
    width: 100%;
    background-color: color-mix(in oklab, var(--_hairline) 70%, transparent);
  }

  /* ── Link columns ────────────────────────────────────────────────────── */
  .footer__columns {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    row-gap: 3rem;
    padding-block: 3.5rem;
  }

  .footer__column-accent {
    display: block;
    height: 0.125rem;
    width: 2rem;
    background-color: var(--_accent);
  }

  .footer__column-heading {
    margin: 1rem 0 0;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--_muted);
  }

  .footer__column-heading--brands {
    font-family: var(--font-futura, inherit);
  }

  .footer__link-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .footer__link-list--brands {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
  }

  .footer__enquiries-text {
    margin: 1.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--_muted);
  }

  .footer__contact-list {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--_muted);
    transition: color 200ms ease;
  }

  .footer__contact-link:hover {
    color: #fff;
  }

  .footer__contact-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: color-mix(in oklab, var(--_muted) 80%, #000);
    transition: color 200ms ease;
  }

  .footer__contact-link:hover .footer__contact-icon {
    color: var(--_accent);
  }

  /* ── Bottom bar ──────────────────────────────────────────────────────── */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--_hairline) 70%, transparent);
  }

  .footer__copyright {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.025em;
    color: var(--_muted);
  }

  .footer__legal-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1.5rem;
    row-gap: 0.5rem;
  }

  /* ── Link, shared by nav lists, enquiries and legal ─────────────────────
     Underline-grow micro-interaction, anchored to the text baseline */
  .footer__link {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--_muted);
    transition: color 200ms ease;
  }

  .footer__link:hover {
    color: #fff;
  }

  .footer__link--small {
    font-size: 0.75rem;
  }

  .footer__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 1px;
    width: 100%;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer__link:hover::after,
  a:focus-visible > .footer__link::after,
  .footer__link:focus-visible::after {
    transform: scaleX(1);
  }

  /* Explicit, verified-contrast focus ring rather than relying on the browser
     default, which isn't guaranteed 3:1 against the near-black footer across
     browsers and OS themes (WCAG 2.2 SC 1.4.11). */
  .footer a:focus-visible {
    outline: 2px solid var(--_accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 40rem) {
    .footer__masthead {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      padding-top: 5rem;
    }

    .footer__socials {
      padding-top: 0.5rem;
    }

    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__column--brands {
      grid-column: span 2 / span 2;
    }
  }

  @media (min-width: 64rem) {
    .footer__container {
      padding-inline: 2rem;
    }

    .footer__masthead {
      padding-top: 6rem;
    }

    .footer__columns {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .footer__column--brands {
      grid-column: span 6 / span 6;
    }

    .footer__column--company,
    .footer__column--enquiries {
      grid-column: span 3 / span 3;
    }

    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__social-link,
    .footer__link,
    .footer__link::after,
    .footer__contact-link,
    .footer__contact-icon {
      transition: none !important;
    }
    .footer__social-link:hover,
    .footer__social-link:focus-visible {
      transform: none !important;
    }
  }
</style>
