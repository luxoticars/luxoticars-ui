---
/*
  Prints what `resolveButton()` decides, and nothing else: the element, the
  classes and every attribute that depends on another come from the resolver,
  which the Marko tag (`src/marko/lx-button/index.marko`) shares, so the two
  renderers agree. No Tailwind: the stylesheet is plain CSS, imported here as
  ProgramBadge.astro and MenuButton.astro import theirs.
*/
import "../../styles/button.css";
import type { HTMLAttributes } from "astro/types";
import type { ButtonPopup, ButtonRadius, ButtonSize, ButtonVariant } from "../../types";
import { resolveButton } from "../../utils/button.js";

export type { ButtonPopup, ButtonRadius, ButtonSize, ButtonVariant };

interface Shared {
  /**
   * Visual treatment. `default` and `secondary` are solid fills; the four
   * status variants are tints that use the status colour as text.
   * @default "default"
   */
  variant?: ButtonVariant;
  /**
   * Height, padding, type scale and the size of any slotted SVG.
   * @default "default"
   */
  size?: ButtonSize;
  /**
   * Square button sized for a single icon. Pass your own `aria-label`: the
   * component cannot infer one from an SVG slot.
   * @default false
   */
  iconOnly?: boolean;
  /**
   * Corner radius. `field` (the default) follows the theme's control radius, so
   * buttons keep matching the other form controls; pick a fixed step to
   * override it for this button. Wins over `pill` when both are set. To set one
   * button's radius from CSS instead, give it `--button-radius`.
   * @default "field"
   */
  radius?: ButtonRadius;
  /**
   * Shorthand for `radius="full"`.
   * @deprecated Use `radius="full"`.
   * @default false
   */
  pill?: boolean;
  /**
   * On the `<a>` branch this drops `href` and sets `aria-disabled`, because an
   * anchor ignores `disabled`.
   * @default false
   */
  disabled?: boolean;
  /**
   * Whether the thing this button shows and hides is open: the trigger of an
   * accordion, a disclosure or a filter panel. Printed as `"true"` or
   * `"false"`, so a closed one still says so. Leave it unset on a button that
   * opens nothing. While `true` the button keeps its pressed look. The state
   * is yours to keep: flip it when the panel opens or closes.
   */
  "aria-expanded"?: boolean | "true" | "false";
  /**
   * That the button opens a popup, and which kind: a `menu` (what `true`
   * means), `listbox`, `tree`, `grid` or `dialog`. Set it on the button that
   * opens a menu or a modal, so assistive tech announces that it does. Leave it
   * unset otherwise: `false` prints nothing.
   */
  "aria-haspopup"?: ButtonPopup;
  /**
   * The `id` of the element this button controls, such as the accordion panel,
   * menu or dialog it opens. Several ids can be given, separated by spaces.
   */
  "aria-controls"?: string;
}

/**
 * A button, or a link that looks like one.
 *
 * With `href` the component renders an `<a>` and accepts anchor attributes
 * (`target`, `rel`, `download`); without it, a `<button>`. Keeping these as a
 * union means the spread is type-checked against the element actually rendered.
 *
 * Slots: default (the label), `left-icon`, `right-icon`.
 *
 * Needs no Tailwind. Colours and radius come from the shared design tokens
 * (`--color-*` where the app defines them, else `--lux-*`). Only tokens daisyUI
 * also defines may be used here — the dash sources its tokens from daisyUI, so
 * anything defined only in `styles/tokens.css` silently has no effect there.
 *
 * Restyle one button by setting `--button-radius`, `--button-bg`,
 * `--button-bg-hover`, `--button-fg`, `--button-padding-inline`,
 * `--button-font-size` or `--button-ring` on it. Tailwind utilities passed as
 * `class` no longer win over the component's own styles (they sit in a lower
 * layer), so use these, or the `radius` prop, instead.
 */
export type Props =
  | (Shared & HTMLAttributes<"button"> & { href?: undefined })
  | (Shared & Omit<HTMLAttributes<"a">, "href"> & { href: string });

/*
  `class` and `class:list` come out of the spread for the reason given in
  MenuButton.astro: an explicit `class` after a spread is emitted as a second
  attribute and the parser keeps the first, so the merged class would be lost.
  Everything else stays in `attrs` and goes through the resolver, which takes out
  the keys it owns (`href`, `type`, `disabled`, `role`, `tabindex`, `aria-*`)
  before they can be duplicated.
*/
const { variant, size, radius, pill, iconOnly, class: className, "class:list": classList, ...attrs } = Astro.props;
const button = resolveButton({ variant, size, radius, pill, iconOnly, className: [className, classList], attrs });
const Tag = button.tag;
---

<Tag {...button.attrs} class={button.className}>
  <slot name="left-icon" />
  <slot />
  <slot name="right-icon" />
</Tag>
