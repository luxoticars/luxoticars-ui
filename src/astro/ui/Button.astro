---
import { cn } from "../../utils/cn.js";
import type { HTMLAttributes } from "astro/types";

export type ButtonVariant =
  | "default"
  | "destructive"
  | "outline"
  | "secondary"
  | "ghost"
  | "link"
  | "success"
  | "warning"
  | "info";

export type ButtonSize = "xs" | "sm" | "default" | "lg" | "xl";

interface Shared {
  /**
   * Visual treatment. `default` and `secondary` are solid fills; the four
   * status variants are tints that use the status colour as text.
   * @default "default"
   */
  variant?: ButtonVariant;
  /**
   * Height, padding, type scale and the size of any slotted SVG.
   * @default "default"
   */
  size?: ButtonSize;
  /**
   * Square button sized for a single icon. Pass your own `aria-label`: the
   * component cannot infer one from an SVG slot.
   * @default false
   */
  iconOnly?: boolean;
  /** Fully rounded, overriding the theme's control radius. @default false */
  pill?: boolean;
  /**
   * On the `<a>` branch this drops `href` and sets `aria-disabled`, because an
   * anchor ignores `disabled`.
   * @default false
   */
  disabled?: boolean;
}

/**
 * A button, or a link that looks like one.
 *
 * With `href` the component renders an `<a>` and accepts anchor attributes
 * (`target`, `rel`, `download`); without it, a `<button>`. Keeping these as a
 * union means the spread is type-checked against the element actually rendered.
 *
 * Slots: default (the label), `left-icon`, `right-icon`.
 *
 * Colours and radius come from the shared design tokens. Only tokens daisyUI
 * also defines may be used here — the dash sources its tokens from daisyUI, so
 * anything defined only in `styles/tokens.css` silently produces no utility there.
 */
export type Props =
  | (Shared & HTMLAttributes<"button"> & { href?: undefined })
  | (Shared & Omit<HTMLAttributes<"a">, "href"> & { href: string });

const props = Astro.props;

const {
  variant = "default",
  size = "default",
  iconOnly = false,
  pill = false,
  href,
  disabled = false,
  class: className,
} = props;

/*
  Splits the component's own props off the attributes that belong to the element
  being rendered. It is generic and called on an already narrowed `Astro.props`,
  so each branch below spreads exactly that element's attributes.

  Destructuring a rest object here in the frontmatter instead — `const { href,
  ...props } = Astro.props` — is what was broken: narrowing `href` cannot narrow
  a rest object bound separately from it, so the rest stayed the union of BOTH
  branches and every spread was checked against both. `<a type="…">` is a MIME
  string, so that union put `type: string` on the `<button>` branch, where it
  collides with `type="button"` — the one thing this union was introduced to
  prevent. `astro check` reported it as: Type 'string' is not assignable to type
  '"button" | "submit" | "reset" | null | undefined'.
*/
function elementAttributes<T extends Props>(all: T) {
  const {
    variant: _variant,
    size: _size,
    iconOnly: _iconOnly,
    pill: _pill,
    disabled: _disabled,
    href: _href,
    class: _class,
    ...attributes
  } = all;

  return attributes;
}

const baseStyles =
  "inline-flex items-center justify-center whitespace-nowrap font-medium transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-base-100 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0";

/*
  Solid variants pair a fill with its `-content` colour. Status variants are
  tinted instead, and use the status colour as TEXT — `-content` colours are
  calibrated against the solid fill and would be invisible on a 10% tint.
  `link` uses accent rather than primary: primary is a fill colour and reads
  1.35:1 as text on the light canvas.
*/
const variantStyles: Record<ButtonVariant, string> = {
  default: "bg-primary text-primary-content hover:bg-primary/90",
  destructive: "bg-error/10 text-error hover:bg-error/20",
  outline: "border border-base-300 bg-base-100 text-base-content hover:bg-base-200",
  secondary: "bg-secondary text-secondary-content hover:bg-secondary/80",
  ghost: "text-base-content hover:bg-base-200",
  link: "text-accent underline-offset-4 hover:underline",
  success: "bg-success/10 text-success hover:bg-success/20",
  warning: "bg-warning/10 text-warning hover:bg-warning/20",
  info: "bg-info/10 text-info hover:bg-info/20",
};

const sizeStyles: Record<ButtonSize, string> = {
  xs: "h-7 px-2.5 gap-1.5 text-xs [&_svg]:size-3",
  sm: "h-8 px-3 gap-1.5 text-xs [&_svg]:size-3.5",
  default: "h-9 px-4 gap-2 text-sm [&_svg]:size-4",
  lg: "h-10 px-6 gap-2.5 text-base [&_svg]:size-5",
  xl: "h-11 px-8 gap-3 text-lg [&_svg]:size-5",
};

const iconOnlySizeStyles: Record<ButtonSize, string> = {
  xs: "size-7 text-xs [&_svg]:size-3",
  sm: "size-8 text-xs [&_svg]:size-3.5",
  default: "size-9 text-sm [&_svg]:size-4",
  lg: "size-10 text-base [&_svg]:size-5",
  xl: "size-11 text-lg [&_svg]:size-5",
};

/*
  An `<a>` cannot be disabled: the attribute is ignored, so `disabled:*`
  utilities never fire and the link stays clickable. A disabled link is
  therefore rendered with the dimming applied unconditionally, pointer events
  removed, `href` dropped so it is not activatable, and `aria-disabled` set so
  assistive tech reports the state a real `<button disabled>` would.
*/
const isDisabledLink = href !== undefined && disabled;

/*
  Attributes for the `<a>`. On a disabled link the caller's own `role`,
  `tabindex` and `aria-disabled` are REMOVED rather than overridden. Astro emits
  a spread's attribute and an explicit attribute of the same name as two
  attributes, and an HTML parser keeps the FIRST of a duplicated pair — so an
  enforced value written after the spread never reaches the DOM. That is what
  `<Button href="/x" disabled tabindex="5" aria-disabled="false">` did: the
  markup carried `tabindex="-1" aria-disabled="true"` further along, yet the
  parsed link stayed focusable and reported itself as enabled.
*/
function anchorAttributes<T extends Props & { href: string }>(all: T) {
  const { role, tabindex, "aria-disabled": ariaDisabled, ...rest } = elementAttributes(all);

  return isDisabledLink
    ? { ...rest, role: "link" as const, tabindex: -1, "aria-disabled": "true" as const }
    : { ...rest, role, tabindex, "aria-disabled": ariaDisabled };
}

/*
  Attributes for the `<button>`. `type` is taken out of the spread and defaulted
  here for the same reason: written as a plain `type="button"` next to the
  spread it duplicated a caller's own `type`, and the first of the pair wins, so
  `<Button type="submit">` rendered a plain button and never submitted its form.
*/
function buttonAttributes<T extends Props & { href?: undefined }>(all: T) {
  const { type, ...rest } = elementAttributes(all);

  return { ...rest, type: type ?? ("button" as const) };
}

const classes = cn(
  baseStyles,
  variantStyles[variant],
  iconOnly ? iconOnlySizeStyles[size] : sizeStyles[size],
  pill ? "rounded-full" : "rounded-[var(--radius-field)]",
  isDisabledLink && "pointer-events-none opacity-50",
  className,
);
---

{
  props.href !== undefined ? (
    <a {...anchorAttributes(props)} href={isDisabledLink ? undefined : props.href} class={classes}>
      <slot name="left-icon" />
      <slot />
      <slot name="right-icon" />
    </a>
  ) : (
    <button {...buttonAttributes(props)} class={classes} disabled={disabled}>
      <slot name="left-icon" />
      <slot />
      <slot name="right-icon" />
    </button>
  )
}
