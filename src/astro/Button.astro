---
interface Props {
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const {
  type = "button",
  class: className = "",
  ariaLabel,
  disabled = false
} = Astro.props as Props;
---

<button
  type={type}
  class={`inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 ${className}`}
  aria-label={ariaLabel}
  disabled={disabled}
>
  <slot />
</button>
