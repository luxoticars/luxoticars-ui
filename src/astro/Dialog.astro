---
interface Props {
  id: string;
  title: string;
  description?: string;
  open?: boolean;
  class?: string;
}

const {
  id,
  title,
  description,
  open = false,
  class: className = ""
} = Astro.props as Props;
const descriptionId = `${id}-description`;
---

<dialog
  id={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  aria-describedby={description ? descriptionId : undefined}
  open={open}
  class="backdrop:bg-slate-900/40"
>
  <div class={`w-full max-w-lg rounded-lg bg-white p-6 shadow-xl focus-visible:outline-none ${className}`}>
    <h2 id={`${id}-title`} class="text-lg font-semibold text-slate-900">{title}</h2>
    {description && (
      <p id={descriptionId} class="mt-2 text-sm text-slate-600">
        {description}
      </p>
    )}
    <div class="mt-4">
      <slot />
    </div>
  </div>
</dialog>
