---
/*
  The rules live in ../styles/logo.css so this component and the HTML API
  (`createLogo`) cannot drift apart — they are one stylesheet, not two copies
  that must be kept identical by hand.

  Imported here in the frontmatter rather than through an `@import` inside a
  scoped style block. Storybook prerenders .astro components and injects the
  style block as its literal source text, so an `@import` inside one resolves
  against the page URL and 404s — the wordmark rendered unstyled. A frontmatter
  import is a module dependency, which both bundlers follow. It makes the rules
  global rather than scoped; the `logo` block namespaces them.
*/
import "../styles/logo.css";

export type Props = {
  /** Wordmark text. @default "Luxoticars" */
  siteTitle?: string;
  /** Where the wordmark links. @default "/" */
  href?: string;
}

const { siteTitle = "Luxoticars", href = "/" } = Astro.props;
---
{/* Home link, not a heading — an h1 down here gives every page on the
    site a second level-1 heading after its real one. */}
<a href={href} class="logo">
  <span class="logo__wordmark">
    {siteTitle}
    <sub class="logo__mark">&copy;</sub>
  </span>
</a>
