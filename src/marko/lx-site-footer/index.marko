/*
  The site footer: the Marko twin of `astro/Footer.astro`. It is the public
  boundary of an adaptive component: the app passes the `entry` for this request
  (desktop or mobile) and the footer's input, and the model is built once and
  handed to the entry. This package does not classify devices; the app does,
  once per request, and imports the entry by path:

    import desktop from "@luxoticars/ui/marko/lx-site-footer/desktop.entry.marko"

  Each entry loads only its own stylesheet and works on its own.

  Concise syntax, by repo convention.
*/
import { buildModel } from "./helper"
import type { ModelInput } from "./helper"

export interface Input extends ModelInput {
  /** The entry chosen for this request: `desktop.entry.marko` or `mobile.entry.marko`. */
  entry: Marko.Template
  /** Replaces the built-in wordmark, as `@logo`. */
  logo?: Marko.AttrTag<{ content: Marko.Body }>
}

const/model=buildModel(input)

${input.entry} model=model logo=input.logo
