/*
  Story-only: the header over a page's worth of text, so the canvas scrolls
  and hide-on-scroll can be tried. The header and the text are siblings, as on
  a real page: a sticky element sticks only while its parent is on screen.
  @storybook/marko 10.1 cannot wrap a Tags API story in a decorator template,
  so the stories render this in the header's place. Its `.stories.` name
  keeps it out of the package (see `files` in package.json).

  Concise syntax, by repo convention.
*/
import SiteHeader from "./index.marko"
import type { Input as HeaderInput } from "./index.marko"

export interface Input extends HeaderInput {}

const/sections=[
  "Every car is inspected before it is listed, and the report sits on its page.",
  "Prices are set by the seller; the graph on the search page shows where one sits.",
  "Financing, insurance and delivery can be arranged once a price is agreed.",
  "Dealers and private sellers list the same way, from the dashboard.",
  "Reviews come from buyers who completed a purchase through the site.",
  "Saved searches tell you when a car that matches comes in.",
]

SiteHeader ...input

main style="display:block;max-width:40rem;margin-inline:auto;padding:2rem 1.5rem 50vh;line-height:1.6"
  h1 style="margin-top:0" -- Scroll down, then back up
  p -- Scrolling down slides the bar out of view; scrolling up, even a little, brings it back. It stays while its menu is open or anything in it has focus: tab into it to see. With reduced motion turned on it never moves.
  for|text, i| of=[...sections, ...sections]
    h2 -- Section ${i + 1}
    p -- ${text}
    p -- ${text}
