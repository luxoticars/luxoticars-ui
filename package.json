{
  "name": "@luxoticars/ui",
  "version": "0.15.4",
  "description": "Accessible components for HTML, Astro, Marko and Tailwind CSS.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxoticars/luxoticars-ui.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:marko": "storybook dev -p 6007 -c .storybook-marko",
    "build-storybook": "storybook build && storybook build -c .storybook-marko -o storybook-static/marko",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:stories": "vitest run",
    "styles:check": "node scripts/style-forks.mjs",
    "styles:stamp": "node scripts/style-forks.mjs --stamp",
    "new:tag": "node scripts/new-tag.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "check:exports": "node scripts/check-exports.mjs",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run check:exports && changeset git-tag"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./html": {
      "types": "./src/html/index.d.ts",
      "default": "./src/html/index.js"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./fonts/*": "./src/fonts/*",
    "./styles/footer.css": "./src/styles/footer.css",
    "./styles/logo.css": "./src/styles/logo.css",
    "./styles/listing-card.css": "./src/styles/listing-card.css",
    "./styles/dialog.css": "./src/styles/dialog.css",
    "./styles/site-header.css": "./src/styles/site-header.css",
    "./styles/site-header-hide-on-scroll.css": "./src/styles/site-header-hide-on-scroll.css",
    "./styles/site-header-frosted-on-scroll.css": "./src/styles/site-header-frosted-on-scroll.css",
    "./styles/pill.css": "./src/styles/pill.css",
    "./styles/section-head.css": "./src/styles/section-head.css",
    "./utils/listing-card": {
      "types": "./src/utils/listing-card.d.ts",
      "default": "./src/utils/listing-card.js"
    },
    "./utils/state-flag": {
      "types": "./src/utils/state-flag.d.ts",
      "default": "./src/utils/state-flag.js"
    },
    "./flags/states/*.svg": "./src/flags/states/*.svg",
    "./utils/cn": {
      "types": "./src/utils/cn.d.ts",
      "default": "./src/utils/cn.js"
    },
    "./data/footer": {
      "types": "./src/data/footer.d.ts",
      "default": "./src/data/footer.js"
    },
    "./scripts/dialog": {
      "types": "./src/scripts/dialog.d.ts",
      "default": "./src/scripts/dialog.js"
    },
    "./astro/*.astro": "./src/astro/*.astro",
    "./astro/*": "./src/astro/*.astro",
    "./marko/lx-site-footer/*.entry.marko": "./src/marko/lx-site-footer/*.entry.marko",
    "./marko/lx-site-header/*.entry.marko": "./src/marko/lx-site-header/*.entry.marko",
    "./marko/lx-site-header/hide-on-scroll.css": "./src/marko/lx-site-header/hide-on-scroll.css",
    "./marko/lx-site-header/frosted-on-scroll.css": "./src/marko/lx-site-header/frosted-on-scroll.css",
    "./marko/lx-*": "./src/marko/lx-*/index.marko",
    "./marko/*.marko": "./src/marko/*.marko",
    "./marko/*": "./src/marko/*.marko",
    "./marko.json": "./marko.json",
    "./src/marko/*.marko": "./src/marko/*.marko"
  },
  "files": [
    "src",
    "!**/{,*.}stories.*",
    "marko.json",
    "README.md"
  ],
  "keywords": [
    "accessibility",
    "astro",
    "marko",
    "tailwindcss",
    "components",
    "ui"
  ],
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "marko": "^6"
  },
  "peerDependenciesMeta": {
    "marko": {
      "optional": true
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.marko"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@storybook-astro/framework": "^1.12.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/builder-vite": "^10.6.5",
    "@storybook/marko": "^10.1.0",
    "@storybook/marko-vite": "^5.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/browser-playwright": "^4.1.12",
    "astro": "^7.3.2",
    "marko": "^6.4.5",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vitest/expect": "$vitest",
    "@vitest/spy": "$vitest",
    "@vitest/utils": "$vitest",
    "@vitest/pretty-format": "$vitest"
  }
}
